{
  "id": "chancellor.how_to_answer",
  "sender": "chancellor",
  "type": "question",
  "skippable": true,
  "speaks_to": 34,
  "params": {
    "amount": "gold"
  },
  "body": [
    {
      "text": "The court asks what is to be done about the colony's returns, which came to {param:amount} last month."
    },
    {
      "text": "I shall need an answer, and I should not like to invent one{insert:barb}.",
      "insert": {
        "barb": {
          "hateful": ", though inventing one would amuse me"
        }
      }
    }
  ],
  "reply": {
    "tone": {
      "text": "I am {choice} to be asked.",
      "options": [
        {
          "tone": "dutiful",
          "text": "content"
        },
        {
          "tone": "annoyed",
          "text": "in no humour"
        }
      ]
    },
    "steps": [
      {
        "id": "answer",
        "prompt": "The returns",
        "options": [
          {
            "id": "pay",
            "label": "answer for them from the Crown's purse",
            "text": "The Crown will answer for them from its own purse, and say no more of it.",
            "effect": {
              "promise_gold": {
                "to": "chancellor",
                "amount": "{amount}"
              }
            }
          },
          {
            "id": "deny",
            "label": "let them stand",
            "text": "They may stand as they are.",
            "effect": {
              "refuse": {
                "to": "chancellor"
              }
            }
          }
        ]
      }
    ],
    "closing": [
      {
        "text": "Yours,",
        "tone": {
          "annoyed": "Briefly yours,"
        }
      }
    ]
  }
}
